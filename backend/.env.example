# Server
PORT=5000
NODE_ENV=development

# Must match the frontend's dev/prod URL(s). Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:5173

# Supabase — Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SECRET — server only. NEVER expose this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Admin -> Landing Media: gallery of images/videos shown on the public
# Landing Page. Files are stored in this Supabase Storage bucket, which the
# backend creates automatically (public read) the first time an admin
# uploads something — nothing to set up manually in the Supabase dashboard.
LANDING_MEDIA_BUCKET=landing-media
LANDING_MEDIA_IMAGE_MAX_MB=8
LANDING_MEDIA_VIDEO_MAX_MB=60

# Auth
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ADMIN_EXPIRES_IN=8h
JWT_STUDENT_EXPIRES_IN=12h

# Default admin account (also seeded into the `admins` table by sql/schema.sql)
ADMIN_EMAIL=admin@gmail.com
# Bcrypt hash of "admin123". Change the password with: npm run hash-password -- "yourNewPassword"
ADMIN_PASSWORD_HASH=$2a$10$Bf.2j0TfLkAgf9hgRohNPeEGvz1LYHvvMl65mvjbetZtt2GdafV9u

# Sandboxed judge for programming questions (Piston-compatible endpoint)
CODE_EXEC_ENABLED=true
CODE_EXEC_PROVIDER=auto
# Optional remote Piston-compatible sandbox (comma separated list).
# Leave EMPTY to use only the toolchains installed on this server.
# The PUBLIC Piston API (emkc.org) is whitelist-only and returns 401 — do not
# use it. Self-host instead:  docker compose -f docker-compose.judge.yml up -d
# CODE_EXEC_URL=http://localhost:2000/api/v2/execute
CODE_EXEC_URL=
CODE_EXEC_TOKEN=
CODE_EXEC_TIMEOUT=15000
# Optional absolute paths to the PRE-INSTALLED toolchains (skip PATH lookup).
# PYTHON_BIN=/usr/bin/python3
# GCC_BIN=/usr/bin/gcc
# GPP_BIN=/usr/bin/g++
# JAVAC_BIN=/usr/lib/jvm/default-java/bin/javac
# JAVA_BIN=/usr/lib/jvm/default-java/bin/java
# Or simply point JAVA_HOME at the JDK root (bin/javac + bin/java are found automatically)
# JAVA_HOME=/usr/lib/jvm/default-java

# --- Code execution fallback -------------------------------------------------
# Preferred order: local toolchain -> CODE_EXEC_URL (self-hosted Piston) ->
# Wandbox (free, key-less public sandbox; no install required).
# Set CODE_EXEC_FALLBACK=off to disable the public fallback entirely.
CODE_EXEC_FALLBACK=wandbox
WANDBOX_URL=https://wandbox.org/api/compile.json
# Optional compiler pinning, e.g. WANDBOX_COMPILERS=c=gcc-12.3.0-c,cpp=gcc-12.3.0
WANDBOX_COMPILERS=

# --- Courses: PDF upload -> AI extraction ------------------------------------
# Admin -> Courses -> "Upload PDF" turns a problem-set PDF into structured
# course problems, bilingual hints/explanations, and a Final Assessment
# using the Google Gemini API. Leave empty to keep manual course/problem
# creation working while disabling PDF auto-import.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- AI learning platform (AI Tutor, Content Simplifier, voice tutor, teacher
# insights narrative). Everything works with NO key at all: the built-in offline
# tutor answers from the lessons. Add a key for open-ended answers.
#   auto      -> Anthropic if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY
#                is set, else the built-in offline tutor
#   anthropic | gemini | local  -> force one
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# If GEMINI_MODEL above isn't valid for your key, requests automatically retry
# once with gemini-2.5-flash. AI_TIMEOUT_MS (default 25000) caps each AI call.
# Max accepted upload size for a course PDF, in megabytes.
PDF_IMPORT_MAX_MB=20

# --- Course certificates: emailing -------------------------------------------
# When a student completes every problem in a course AND passes its Final
# Assessment, a certificate PDF is generated and emailed to their registered
# Gmail. Uses Gmail SMTP with an App Password (NOT your normal Gmail
# password) — create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
# Leave SMTP_USER / SMTP_PASS empty to keep certificate generation and
# Dashboard download working while disabling outbound email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional "Display Name <address@gmail.com>" — defaults to SMTP_USER.
SMTP_FROM=
